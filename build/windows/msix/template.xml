<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="better-docker-desktop-go.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\Better Docker Desktop">
    </Installer>
    <PackageInformation
        PackageName="Better Docker Desktop"
        PackageDisplayName="Better Docker Desktop"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="A better-docker-desktop-go application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.rea.betterdockerdesktop"
                Description="A better-docker-desktop-go application"
                DisplayName="Better Docker Desktop"
                ExecutableName="better-docker-desktop-go.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Better Docker Desktop</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>A better-docker-desktop-go application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="better-docker-desktop-go.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
